---
// ============================================================
// 404.astro — 404 页
// ============================================================
// Astro 静态构建自动产出 dist/404.html，Vercel / Netlify 原生识别。
// 文案扣题：器 = 被形状规定的东西；走错路 = 遇见一个「未成形的位置」。
// ============================================================

import Base from '../layouts/Base.astro';
---

<Base title="404 — unvessel 不器" description="你要找的页面不在任何容器里。">
  <section class="nf" aria-label="页面不存在">
    <i class="cross cross--tl" aria-hidden="true">+</i>
    <i class="cross cross--tr" aria-hidden="true">+</i>
    <i class="cross cross--bl" aria-hidden="true">+</i>
    <i class="cross cross--br" aria-hidden="true">+</i>

    <p class="nf__kicker" data-rv>
      <span class="kdot" aria-hidden="true"></span>
      ERROR 404 — PAGE NOT FOUND
    </p>

    <!-- 巨字：40 实心 + 4 空心，呼应首页「不」实「器」虚 -->
    <h1 class="nf__code" aria-label="404">
      <span data-rv style="--d:.10s">4</span><span data-rv style="--d:.20s">0</span><span class="hollow" data-rv style="--d:.30s">4</span>
    </h1>

    <p class="nf__line" data-rv style="--d:.45s">器未成，路已失。</p>
    <p class="nf__sub" data-rv style="--d:.55s">
      你要找的页面不在任何容器里——它可能从未成形，也可能已经改名迁移。
    </p>

    <nav class="nf__links" data-rv style="--d:.65s" aria-label="404 导航">
      <a class="nf__link nf__link--primary" href="/">← 回到首页</a>
      <a class="nf__link" href="/posts/">文章列表</a>
      <a class="nf__link" href="/logs/">站点日志</a>
    </nav>
  </section>
</Base>
