---
// ============================================================
// photos.astro — 相册
// ============================================================
// 数据源：public/photos/ 目录构建期自动扫描（src/data/photos.ts）。
// 零维护：图片丢进目录即上墙，文件名即图注（日期前缀可选）。
// 空目录 = 真实的「胶卷未装」状态：显示投放说明面板，不放假图占位。
// 视觉：直角发丝线相框 + 编号图注（与正文 prose 的 figure 语言一致）。
// ============================================================

import Base from '../layouts/Base.astro';
import { scanPhotos } from '../data/photos';

// 目录扫描（内部已按日期倒序：新照片在前）
const photos = scanPhotos();
---

<Base title="相册 — unvessel 不器" description="不器的相册：文字之外，光的痕迹。">
  <!-- ===== 页头 ===== -->
  <header class="page-head">
    <p class="page-head__kicker" data-rv>
      <span class="kdot" aria-hidden="true"></span>
      PHOTOS — 相册
    </p>
    <h1 class="page-head__title" aria-label="相册">
      <span data-rv style="--d:.08s">相</span><span class="hollow" data-rv style="--d:.18s">册</span>
    </h1>
    <p class="page-head__meta" data-rv style="--d:.28s">
      <span>文字之外，光的痕迹</span>
      <span>{String(photos.length).padStart(2, '0')} FRAMES</span>
    </p>
  </header>

  {photos.length === 0 ? (
    <!-- ===== 空状态：胶卷未装（真实状态，指引投放） ===== -->
    <section class="photos-empty" data-rv aria-label="相册暂无照片">
      <p class="photos-empty__mark" aria-hidden="true">▢</p>
      <h2 class="photos-empty__title">胶卷未装</h2>
      <p class="photos-empty__desc">
        相册等待第一批光。照片投放方式：
      </p>
      <ol class="photos-empty__steps">
        <li>图片文件丢进 <code>public/photos/</code>（建议 .jpg / .webp，长边 ≤ 2000px）</li>
        <li>文件名即图注：<code>YYYY-MM-DD-标题.jpg</code>（日期前缀可省，缺省取文件修改时间）</li>
        <li>重新 build，照片自动上墙——无需改动任何代码</li>
      </ol>
    </section>
  ) : (
    <!-- ===== 照片网格 ===== -->
    <section class="photos-grid" aria-label="照片列表">
      {photos.map((p, i) => (
        <figure class="photo" data-rv>
          <div class="photo__frame">
            <img src={p.src} alt={p.title} loading="lazy" decoding="async" />
          </div>
          <figcaption class="photo__cap">
            <span class="photo__no">P-{String(i + 1).padStart(2, '0')}</span>
            <span class="photo__meta">
              <strong>{p.title}</strong>
              {p.note && <em>{p.note}</em>}
            </span>
            <time class="photo__date" datetime={p.date}>{p.date}</time>
          </figcaption>
        </figure>
      ))}
    </section>
  )}
</Base>
