---
// ============================================================
// posts/index.astro — 文章列表页
// ============================================================
// 页头巨字「文章」+ 全部文章的签名行列表（倒序）。
// ============================================================

import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostRow from '../../components/PostRow.astro';

// 全部正式文章，倒序（草稿不出现在构建产物）
const allPosts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const count = String(allPosts.length).padStart(3, '0');
---

<Base title={`文章 — unvessel 不器`} description="不器的全部文章，按时间倒序。">
  <!-- ===== 页头 ===== -->
  <header class="page-head">
    <p class="page-head__kicker" data-rv>
      <span class="kdot" aria-hidden="true"></span>
      ARCHIVE — 全部文章
    </p>
    <h1 class="page-head__title" aria-label="文章">
      <span data-rv style="--d:.08s">文</span><span class="hollow" data-rv style="--d:.18s">章</span>
    </h1>
    <p class="page-head__meta" data-rv style="--d:.28s">
      <span>{count} FILES</span>
      <span>INK VOID / 墨渊</span>
    </p>
  </header>

  <!-- ===== 列表 ===== -->
  <section class="works" aria-label="文章列表" style="padding-top: 0;">
    <ol class="works__list">
      {allPosts.map((post, i) => <PostRow post={post} idx={allPosts.length - i} />)}
    </ol>
  </section>
</Base>
