---
// ============================================================
// posts/[...slug].astro — 文章详情页（中文壳）
// ============================================================
// 路径：/posts/<短链 uid>/（postUid：frontmatter uid 优先 / 文件名哈希兜底，
// 全站链接唯一来源，见 src/lib/utils.ts）。
// 中文站为全部展示稿生成页面；渲染实现全在 templates/PostDetailView.astro。
// ============================================================

import PostDetailView from '../../templates/PostDetailView.astro';
import { getDisplayPosts } from '../../lib/posts';
import { postUid } from '../../lib/utils';

export async function getStaticPaths() {
  // 展示列表里的每一篇都生成详情页（双语配对口径，草稿整对剔除）
  const posts = await getDisplayPosts('zh');
  return posts.map((post) => ({
    params: { slug: postUid(post) },
    props: { post },
  }));
}

const { post } = Astro.props;
---

<PostDetailView lang="zh" post={post} />
