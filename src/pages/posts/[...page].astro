---
// ============================================================
// posts/[...page].astro — 文章列表页（中文壳）
// ============================================================
// rest 路由 + paginate()：第 1 页生成 /posts/，第 2 页起 /posts/2/…
// 数据源 = lib/posts.getDisplayPosts('zh')（双语配对 + 排序口径统一）；
// 页头 / 列表 / 数字页码的渲染实现全在 templates/PostsListView.astro。
// ============================================================

import PostsListView from '../../templates/PostsListView.astro';
import { getDisplayPosts } from '../../lib/posts';

export async function getStaticPaths({ paginate }) {
  // 中文展示列表（置顶优先 + 日期倒序；配对口径见 lib/posts.ts）。
  // 每页 10 篇：行高很大（clamp 22-40px 的巨字行），一屏读完不滚动刚好。
  const posts = await getDisplayPosts('zh');
  return paginate(posts, { pageSize: 10 });
}

const { page } = Astro.props;
---

<PostsListView lang="zh" page={page} />
