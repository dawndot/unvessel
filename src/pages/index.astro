---
// ============================================================
// index.astro — 首页
// ============================================================
// 结构（沿用 v2 概念稿的单页节奏）：
// Hero（不器巨字 + 竖排 slogan）→ 无缝横滚 → 最新文章 → 宣言。
// 页脚与全局骨架在 Base.astro。
// ============================================================

import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostRow from '../components/PostRow.astro';
// 文章短链 ID 的唯一取值函数（与路由/RSS/计数同源，见 src/lib/utils.ts）
import { postUid } from '../lib/utils';

// 最新 5 篇（排除草稿）。排序口径与 /posts/ 列表页一致：
// 置顶（pinned）永远在最前，其后按发布日期倒序。
const allPosts = (await getCollection('posts', ({ data }) => !data.draft)).sort((a, b) => {
  if (a.data.pinned !== b.data.pinned) return a.data.pinned ? -1 : 1;
  return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
});
const latest = allPosts.slice(0, 5);
// 档案号：按纯时间序编号（001 = 最旧），置顶只影响显示位次、不改变编号，
// 避免置顶的老文顶到最上却挂着最大的号。
const chronoNo = new Map(
  [...allPosts]
    .sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf())
    .map((p, i) => [p.id, i + 1]),
);
// 精选：frontmatter featured: true 的文章（编辑意志钉选，最多 2 篇大卡）
const featured = allPosts.filter((p) => p.data.featured).slice(0, 2);
const count = String(allPosts.length).padStart(3, '0');

/**
 * 横滚带内容（胶片边码风格）：一份 group 渲染两份实现无缝循环。
 * 视觉定位从「巨字表演」降为「走带铭文」：等宽小字慢速滚动，
 * 与顶栏 EST、页脚 fine print 同一语言；accent = 朱砂唯一点色。
 */
const marquee = [
  { t: '愿被看见' },
  { t: '不被定义', accent: true },
  { t: 'UNVESSEL' },
  { t: '不器' },
  { t: '非容器' },
];
---

<Base
  title="unvessel 不器 — 愿被看见，不被定义"
  description="不器的个人领地：写作、作品与实验。愿被看见，不被定义。"
>
  <!-- ===== Hero：视口级巨字 ===== -->
  <section class="hero" aria-label="首屏">
    <!-- 四角十字标：制图基准点 -->
    <i class="cross cross--tl" aria-hidden="true">+</i>
    <i class="cross cross--tr" aria-hidden="true">+</i>
    <i class="cross cross--bl" aria-hidden="true">+</i>
    <i class="cross cross--br" aria-hidden="true">+</i>

    <p class="hero__kicker" data-rv style="--d:.05s">
      <span class="kdot" aria-hidden="true"></span>
      A PERSONAL VOID — SINCE 2026
    </p>

    <h1 class="hero__title" aria-label="不器">
      <span class="g" data-rv style="--d:.10s"><span class="gi">不</span></span>
      <span class="g g--hollow" data-rv style="--d:.22s"><span class="gi">器</span></span>
    </h1>

    <!-- 竖排 slogan：「不被定义」被朱砂竖线划掉 -->
    <p class="hero__slogan" data-rv style="--d:.40s">
      <span class="vtext">愿被看见</span>
      <span class="vtext vtext--strike">不被定义</span>
    </p>

    <div class="hero__meta" data-rv style="--d:.55s">
      <span>君子不器</span>
      <span>非容器 — UNVESSEL</span>
      <span>EST. 2026</span>
    </div>
  </section>

  <!-- ===== 无缝横滚带（胶片边码：等宽小字慢速循环） ===== -->
  <section class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {[0, 1].map(() => (
        <div class="marquee__group">
          {marquee.map((w) => (
            <>
              <span class:list={['mq', { 'mq--accent': w.accent }]}>{w.t}</span>
              <span class="mq-sep"></span>
            </>
          ))}
        </div>
      ))}
    </div>
  </section>

  <!-- ===== 精选文章：编辑钉选大卡（无 featured 文章时整区不渲染） ===== -->
  {featured.length > 0 && (
    <section class="featured" aria-labelledby="featured-label">
      <div class="sec-head">
        <p class="sec-head__label" id="featured-label">FEATURED<span>精选</span></p>
        <span class="sec-head__count">/{String(featured.length).padStart(2, '0')} — 编辑钉选</span>
      </div>
      <div class="featured__list">
        {featured.map((post, i) => (
          <a
            class:list={[
              'featured__item',
              post.data.cover ? 'featured__item--cover' : 'featured__item--plain',
            ]}
            href={`/posts/${postUid(post)}/`}
            data-rv
            style={`--d:${0.05 * i}s`}
          >
            {/* 头图大卡：图铺满整卡做底层，标题叠加在暗化渐变之上 */}
            {post.data.cover && (
              <span class="featured__media" aria-hidden="true">
                <img src={post.data.cover} alt="" loading="lazy" decoding="async" />
              </span>
            )}
            <span class="featured__body">
              <span class="featured__no">F-{String(i + 1).padStart(2, '0')} — 编辑钉选</span>
              <span class="featured__title">{post.data.title}</span>
              <span class="featured__desc">{post.data.description}</span>
            </span>
            <span class="featured__arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- ===== 最新文章：签名交互（悬停朱砂反白） ===== -->
  <section class="works" aria-labelledby="works-label">
    <div class="sec-head">
      <p class="sec-head__label" id="works-label">LATEST FILES<span>最新文章</span></p>
      <a class="sec-head__count" href="/posts/">/{count} — 全部文章 →</a>
    </div>
    <ol class="works__list">
      {latest.map((post) => <PostRow post={post} idx={chronoNo.get(post.id) ?? 1} />)}
    </ol>
  </section>

  <!-- ===== 宣言 ===== -->
  <section class="manifesto" aria-labelledby="manifesto-label">
    <p class="manifesto__label" id="manifesto-label" data-rv>MANIFESTO<span>宣言</span></p>
    <p class="manifesto__l1" data-rv style="--d:.05s">
      君子<span class="hollow">不器</span>
    </p>
    <p class="manifesto__l2" data-rv style="--d:.15s">《周易·系辞上》——形而上者谓之道，形而下者谓之器</p>
    <p class="manifesto__l3" data-rv style="--d:.25s">
      愿被看见，<em>不被定义</em>。
    </p>
  </section>
</Base>
