---
// ============================================================
// SearchModal.astro — 站内检索浮层
// ============================================================
// 数据源：Pagefind 构建期索引（npm run build 时扫 dist 生成 /pagefind/）。
// 交互逻辑全部在 src/scripts/main.js 的 initSearch()：
//   - 唤起：Ctrl/⌘+K、"/"（非输入态）、顶栏「检索」按钮
//   - 关闭：ESC、点击遮罩
//   - 选择：↑↓ 移动，↵ 经 ClientRouter navigate 跳转（墨画布不断帧）
// 本组件只负责静态骨架；dev 环境无 /pagefind/，加载失败时静默降级
// （浮层能开，提示「索引不可用」——文案由 main.js 按运行时语言取自
// 字典 t.search.unavailable），build/preview 与线上一切正常。
//
// 多语言：骨架文案（placeholder / aria / 键位提示）在构建期按 lang
// 渲染；运行时状态文案（idle / unavailable / empty）由 main.js 读
// <html data-lang> 从同一字典取列——两处共用 t.search.*，口径一致。
// ============================================================
import { ui, type Lang } from '../i18n/ui';

interface Props {
  /** 站点语言：决定浮层静态文案 */
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<div class="search" id="search" hidden>
  <!-- 遮罩：点击即关 -->
  <div class="search__scrim" data-search-close aria-hidden="true"></div>

  <!-- 面板：输入行 / 结果列表 / 键位提示，三段式与站内网格同源 -->
  <div class="search__panel" role="dialog" aria-modal="true" aria-label={t.search.dialogAria}>
    <div class="search__bar">
      <span class="search__glyph" aria-hidden="true">⌕</span>
      <input
        class="search__input"
        type="text"
        placeholder={t.search.placeholder}
        autocomplete="off"
        spellcheck="false"
        aria-label={t.search.inputAria}
      />
      <button class="search__esc" type="button" data-search-close aria-label={t.search.escAria}>ESC</button>
    </div>
    <ul class="search__results" id="search-results"></ul>
    <div class="search__hint" aria-hidden="true">
      <span>{t.search.hintSelect}</span>
      <span>{t.search.hintOpen}</span>
      <span>{t.search.hintClose}</span>
    </div>
  </div>
</div>
