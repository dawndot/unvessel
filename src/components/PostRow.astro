---
// ============================================================
// PostRow.astro — 文章列表行（克制悬停：标题转朱砂 + 左缘细线）
// ============================================================
// 使用处：首页「最新文章」与 /posts/ 列表页。
// 传入内容集合条目与展示序号，内部只做展示格式化。
// ============================================================

import { formatDate, postUid } from '../lib/utils';

interface Props {
  /** 内容集合条目（posts collection） */
  post: any;
  /** 展示序号（从 1 起，渲染成 001 风格） */
  idx: number;
}

const { post, idx } = Astro.props;
const { title, description, pubDate, tags, draft, pinned } = post.data;

/** 标签列：无标签显示占位符，保持网格列不塌 */
const cat = tags.length > 0 ? tags.join(' / ') : '—';
/** 草稿标记：列表里用朱砂小旗提示（draft 在查询层通常已过滤，防御性展示） */
const flag = draft ? ' [草稿]' : '';
---

<li>
  <a class="row" href={`/posts/${postUid(post)}/`}>
    {/* 置顶表达（2026-09-11 第三版）：不走标题行（徽标压巨字太抢戏），
        也不走日期区（朱砂字夹在分类与日期之间像第三个分类），
        收敛为行首档案号变色——置顶行的 001 转朱砂，
        「最旧却排最前」由行首一点红解释，零新增元素 */}
    <span class:list={['row__idx', pinned && 'row__idx--pin']}>{String(idx).padStart(3, '0')}</span>
    <span class="row__main">
      <span class="row__title">
        {/* 标题行只放标题（+草稿旗）：置顶标记两版试错后收敛到行首档案号，
            见上方 row__idx 处注释 */}
        {title}{flag}
      </span>
      <span class="row__sub">{description}</span>
    </span>
    <span class="row__cat">{cat}</span>
    <span class="row__datewrap">
      <time class="row__date" datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
    </span>
    <span class="row__arrow" aria-hidden="true">→</span>
  </a>
</li>
