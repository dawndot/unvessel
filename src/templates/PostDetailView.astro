---
// ============================================================
// PostDetailView.astro — 文章详情页共享模板（中英两站渲染同一结构）
// ============================================================
// 中文壳 pages/posts/[...slug].astro 与英文壳 pages/en/posts/[...slug].astro
// 各自 getStaticPaths（en 壳对无译文文章也生成页面 = 回退展示中文稿），
// 本模板负责渲染：阅读进度条 / 文章头 / 目录（桌面右栏 + 移动折叠）/
// 正文 / 阅读量 / 评论 / 文末导航（上一篇下一篇 + 返回）。
// 与原单语言实现的两点差异：
//   - 站内链接经 localePath（en 站带 /en 前缀）；
//   - 相邻文章与 FILE 编号都按「展示列表」（getDisplayPosts，uid 定位）
//     计算——英文站对同一篇稿子的编号与中文站保持一致。
// ============================================================

import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Comments from '../components/Comments.astro';
import Metrics from '../components/Metrics.astro';
import { getDisplayPosts, type PostEntry } from '../lib/posts';
import { formatDate, postUid } from '../lib/utils';
import { ui, localePath, type Lang } from '../i18n/ui';

interface Props {
  /** 站点语言（壳里写死） */
  lang: Lang;
  /** 展示稿（en 站可能是回退的中文稿——正文照常渲染，头部落语言标注） */
  post: PostEntry;
}

const { lang, post } = Astro.props;
const t = ui[lang];

// cover：frontmatter 头图（可选）。三处联动：
// 文章页头图展示 / og:image 分享卡 / 首页精选大卡（首页自己读）
const { title, description, pubDate, tags, cover } = post.data;
// headings：Astro markdown 渲染器自带的标题表（depth/slug/text），
// slug 与正文里自动生成的 heading id 一致，可直接做锚点跳转
const { Content, headings } = await render(post);

// 目录数据：只取 h2/h3 —— h1 是文章标题本身，h4 以下太碎不进目录
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

/**
 * 阅读时长估算：中文稿按有效字数（去空白 ÷ 400 字/分），
 * 英文稿按词数（÷ 220 词/分）——两种语言的信息密度不同，分开估。
 * 英文站回退展示中文稿时（post.data.lang === 'zh'）自动按中文口径。
 */
function readMinutes(body: string | undefined, contentLang: 'zh' | 'en'): number {
  if (!body) return 1;
  if (contentLang === 'en') {
    const words = body.split(/\s+/).filter(Boolean).length;
    return Math.max(1, Math.round(words / 220));
  }
  const chars = body.replace(/\s/g, '').length;
  return Math.max(1, Math.round(chars / 400));
}
const minutes = t.detail.minutes.replace('{n}', String(readMinutes(post.body, post.data.lang)));

/**
 * 语言回退标注：展示稿语言 ≠ 站点语言时（英文站回退中文稿）
 * 在文章头 meta 里明示内容语言，避免读者点进来才发现看不懂。
 */
const fallback = post.data.lang !== lang ? t.detail.fallback : '';

// 展示列表（双语配对口径，与列表页同源）：用于 FILE 编号与相邻文章
const all = await getDisplayPosts(lang);
const pos = all.findIndex((p) => postUid(p) === postUid(post));
// FILE 编号 = 展示列表倒序位次（最新 = 001），中英两站同文同号
const idx = String(pos + 1).padStart(3, '0');
// all 为倒序（新 → 旧）：左邻是更新的文章、右邻是更早的
const newer = pos > 0 ? all[pos - 1] : null;
const older = pos >= 0 && pos < all.length - 1 ? all[pos + 1] : null;
---

<Base
  lang={lang}
  title={`${title} — ${t.brand.siteName}`}
  description={description}
  ogType="article"
  publishedTime={pubDate}
  ogImage={cover}
>
  <!--
    阅读进度条：固定在顶栏下沿的 2px 朱砂细线，
    transform: scaleX 由 main.js 的 initPostTools 随滚动驱动（无 JS 时宽度为 0，不碍事）。
  -->
  <div class="read-progress" aria-hidden="true"><i></i></div>

  <!--
    文章头：data-pagefind-body 把此区块标记进搜索索引
    （Pagefind 规则：站点内任何页面带此标记后，未标记页面一律不入索引
    → 只有文章页进索引，首页/列表/关于页天然排除）。
    h1 自动成为结果标题，data-pagefind-meta 补充日期供结果行展示。
  -->
  <header class="post-head" data-pagefind-body>
    <div class="post-head__meta">
      <span class="accent">FILE {idx}</span>
      <time datetime={pubDate.toISOString()} data-pagefind-meta="date">{formatDate(pubDate)}</time>
      <span>{minutes}</span>
      {tags.length > 0 && <span>{tags.join(' / ')}</span>}
      {/* 回退展示的中文稿（英文站）：meta 尾部落内容语言标注 */}
      {fallback && <span class="post-head__fallback">{fallback}</span>}
    </div>
    <h1 class="post-head__title" data-rv style="--d:.06s">{title}</h1>
    <p class="post-head__desc" data-rv style="--d:.16s">{description}</p>
  </header>

  <!--
    头图（cover）：frontmatter 配了才渲染；细线框裁切与站内卡片同语言，
    宽幅 21:9 附近取高，导语与正文之间像一幕定场镜头。
  -->
  {cover && (
    <figure class="post-cover">
      <img src={cover} alt="" loading="eager" decoding="async" />
    </figure>
  )}

  <!-- ===== 正文 ===== -->
  <!--
    prose-wrap 是三列网格：1fr | 正文(38em) | 1fr。
    桌面端目录（.post-toc）落位右列吸顶；移动端换成一篇文章开头的折叠面板（.post-toc-m）。
    两块目录都带 data-pagefind-ignore：目录词组不进搜索索引，避免污染正文摘要。
  -->
  <article class="prose-wrap" data-pagefind-body>
    {toc.length > 0 && (
      <details class="post-toc-m" data-pagefind-ignore>
        <summary>{t.detail.tocMobile.replace('{n}', String(toc.length))}</summary>
        <ul>
          {toc.map((h) => (
            <li class={`post-toc__item post-toc__item--d${h.depth}`}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ul>
      </details>
    )}
    <div class="prose">
      <Content />
    </div>
    {toc.length > 0 && (
      <aside class="post-toc" aria-label={t.detail.tocAria} data-pagefind-ignore>
        <p class="post-toc__label">{t.detail.tocLabel}</p>
        <ul>
          {toc.map((h) => (
            <li class={`post-toc__item post-toc__item--d${h.depth}`}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ul>
      </aside>
    )}
  </article>

  <!-- ===== 阅读量 / 点赞（API 缺席时自动隐藏，见 api/metrics.ts） ===== -->
  <Metrics lang={lang} slug={postUid(post)} />

  <!-- ===== 评论区（Giscus；site.ts 未配置时渲染「未点亮」指引） ===== -->
  <Comments lang={lang} />

  <!-- ===== 文末导航 ===== -->
  <!--
    两层：上层 = 上一篇/下一篇导航卡（左「更早」右「更新」；首末篇缺一侧时
    只渲染存在的一侧，CSS 把落单的「下一篇」卡推到右列，保持左右语义位）。
    下层 = 返回列表 + 品牌署名。标题与链接取展示稿（en 站优先显示英文标题）。
  -->
  <nav class="post-foot" aria-label={t.detail.navAria}>
    {(older || newer) && (
      <div class="post-foot__nav">
        {older && (
          <a class="post-foot__card" href={localePath(lang, `/posts/${postUid(older)}/`)}>
            <span class="post-foot__dir">{t.detail.older}</span>
            <span class="post-foot__title">{older.data.title}</span>
          </a>
        )}
        {newer && (
          <a class="post-foot__card post-foot__card--next" href={localePath(lang, `/posts/${postUid(newer)}/`)}>
            <span class="post-foot__dir">{t.detail.newer}</span>
            <span class="post-foot__title">{newer.data.title}</span>
          </a>
        )}
      </div>
    )}
    <div class="post-foot__inner">
      <a class="post-foot__back" href={localePath(lang, '/posts/')}>{t.detail.back}</a>
      <span class="post-foot__back">UNVESSEL</span>
    </div>
  </nav>
</Base>
