---
// ============================================================
// Base.astro — 全站基础布局
// ============================================================
// 职责：head（字体/meta/视图过渡/主题防闪烁）+ 全局骨架
// （流体墨画布 / 顶栏 / 页脚 / 噪点 / 自定义光标）+ 脚本装配。
// 页面只往 <slot /> 里填各自的内容。
//
// 【多语言】（2026-09-11）
// 每个页面必须传 lang（zh / en），本布局据此：
//   - <html lang> 与 data-lang（main.js 运行时读它选字典列）；
//   - 界面文案经 ui[lang] 取列（字典见 src/i18n/ui.ts）；
//   - 导航与页脚链接经 localePath 加上语言前缀（en → /en/…）；
//   - head 写入 hreflang alternate（中英互指，SEO 权重合并）；
//   - 顶栏渲染语言切换链接（指向当前页在另一语言下的对应地址）。
// 「界面跟语言走，内容跟稿子走」——品牌视觉（巨字「不器」、朱砂印、
// 器皿标记）是图形而非文案，任何语言下保持原样。
// ============================================================

// ClientRouter：Astro 视图过渡（浏览器端路由），配合 transition:persist 保留墨画布
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
// 站内搜索浮层（Pagefind 前端壳，索引由 build 管线生成）
import SearchModal from '../components/SearchModal.astro';
// 站点档案（联络 / 社交链接 / 建站日期，全站唯一数据源）
import { PROFILE } from '../data/profile';
// i18n 字典与路径工具（全站唯一文案与语言路径来源）
import {
  ui,
  htmlLang,
  ogLocale,
  localePath,
  otherLocalePath,
  type Lang,
} from '../i18n/ui';

// —— 字体自托管（取代 fonts.loli.net CDN）——
// @fontsource 各字重 CSS 内含按 unicode-range 切片的多个 @font-face，
// 浏览器只下载当前页用到的字形片，行为与 CDN 一致但产物完全自持：
// 消除第三方单点故障，国内访问不再依赖镜像站可用性。
import '@fontsource/anton'; // 巨字英文（Anton，唯一字重 400）
import '@fontsource/jetbrains-mono/400.css'; // 等宽：元信息 / 代码
import '@fontsource/jetbrains-mono/700.css'; // 等宽加粗：强调行
import '@fontsource/noto-sans-sc/400.css'; // 中文黑体：正文
import '@fontsource/noto-sans-sc/500.css'; // 中文黑体：次强调
import '@fontsource/noto-sans-sc/700.css'; // 中文黑体：加粗
import '@fontsource/noto-sans-sc/900.css'; // 中文黑体：巨字
import '@fontsource/noto-serif-sc/900.css'; // 中文宋体：沉底「不器」/ 引用

interface Props {
  /** 页面语言（决定 <html lang>、文案字典列、链接前缀、hreflang） */
  lang: Lang;
  /** 页面标题（<title>） */
  title: string;
  /** 页面描述（meta description / SEO / OG）；缺省用该语言的站点默认描述 */
  description?: string;
  /** OG 分享图：站点绝对路径（如 /og-default.png）或完整 URL；缺省用全站默认图 */
  ogImage?: string;
  /** og:type：文章页传 'article'，其余默认 'website' */
  ogType?: 'website' | 'article';
  /** 文章发布时间（article:published_time），仅文章页传 */
  publishedTime?: Date;
}

const {
  lang,
  title,
  description = ui[lang].brand.defaultDesc,
  ogImage = '/og-default.png',
  ogType = 'website',
  publishedTime,
} = Astro.props;

/** 当前语言字典列（页面内一律 t.xxx 取文案，不散落三元判断） */
const t = ui[lang];
/** 另一语言（hreflang alternate / og:locale:alternate / 语言切换链接用） */
const other: Lang = lang === 'zh' ? 'en' : 'zh';

// —— SEO 基准：canonical 与 OG 链接一律由 site 域名推导 ——
// Astro.site 来自 astro.config.mjs（单点配置）；这样无论部署到哪个域名，
// 分享卡片和规范链接都不会指向 dev 地址或旧域名。
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);

/** 当前路径：导航高亮 / hreflang 互指 / 语言切换链接的共同输入 */
const path = Astro.url.pathname;

/**
 * 主导航：首页 + 五个内容板块 + 关于。
 * 编号保持 v2 概念稿的 00-05 节奏并延伸（00 留给首页，站点从这里出发；
 * 06 自留地是后加的私人板块：爱好记录 + 灵感碎片，殿后作彩蛋）。
 * 宣言不再独立成页：立场浓缩进关于页与首页尾章。
 * 页脚站点地图复用本数组——导航与页脚永远同源，不会出现一边多一边少。
 * 标签取字典列、链接经 localePath 加语言前缀：中英两站结构自动一致。
 */
const NAV = [
  { no: '00', label: t.nav.home, href: localePath(lang, '/') },
  { no: '01', label: t.nav.posts, href: localePath(lang, '/posts/') },
  { no: '02', label: t.nav.works, href: localePath(lang, '/works/') },
  { no: '03', label: t.nav.photos, href: localePath(lang, '/photos/') },
  { no: '04', label: t.nav.logs, href: localePath(lang, '/logs/') },
  { no: '05', label: t.nav.about, href: localePath(lang, '/about/') },
  { no: '06', label: t.nav.garden, href: localePath(lang, '/garden/') },
];

/** 判断某导航项是否为当前页（联络是 mailto，永不匹配） */
function isCurrent(href: string): boolean {
  if (!href.startsWith('/')) return false;
  if (href === '/') return path === '/' || path === '/en/';
  return path === href || path.startsWith(href);
}
---

<!doctype html>
<html lang={htmlLang[lang]} data-lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!--
      主题防闪烁（关键路径内联脚本）：
      必须在首帧渲染前定下 data-theme，否则暗色用户会先看到一帧亮色。
      优先级：localStorage 记忆 > 系统偏好 > 默认暗色（站点品牌基调）。
      key 与 main.js 的切换逻辑共用 'unv-theme'，值只允许 light / dark。
    -->
    <script is:inline>
      (function () {
        var saved = null;
        try {
          saved = localStorage.getItem('unv-theme');
        } catch (e) {
          /* 隐私模式等存不进去就算了，走系统偏好 */
        }
        var theme =
          saved === 'light' || saved === 'dark'
            ? saved
            : window.matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';
        document.documentElement.dataset.theme = theme;
      })();
    </script>

    <!-- favicon：svg 内嵌 prefers-color-scheme 自适应深浅标签条；
         png 兜底（Safari 等不认 svg favicon 的浏览器）兼 iOS 主屏图标 -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <!--
      SEO：canonical 指向正式域名下的当前页（含语言前缀），
      避免带查询参数的镜像 URL 稀释搜索权重。
    -->
    <link rel="canonical" href={canonicalURL} />

    <!--
      hreflang 互指：告诉搜索引擎同一页面的另外语言版本（URL 结构严格
      一一对应，见 src/i18n/ui.ts 的 otherLocalePath）。sitemap 集成也会
      产出 hreflang，这里显式声明是给未进 sitemap 的边角页兜底。
      x-default 指向站点根（默认语言 = 中文首页）。
    -->
    <link
      rel="alternate"
      hreflang={htmlLang.zh}
      href={new URL(otherLocalePath('zh', path), Astro.site)}
    />
    <link
      rel="alternate"
      hreflang={htmlLang.en}
      href={new URL(otherLocalePath('en', path), Astro.site)}
    />
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />

    <!--
      站点发现入口：
      - sitemap：@astrojs/sitemap 产出的索引（robots.txt 同步指向）
      - RSS：中英双语 feed 各一条（feed.xml / en/feed.xml，构建期生成）
    -->
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      hreflang={htmlLang[lang]}
      title={t.brand.siteName}
      href={new URL(localePath(lang, '/feed.xml'), Astro.site)}
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      hreflang={htmlLang[other]}
      title={ui[other].brand.siteName}
      href={new URL(localePath(other, '/feed.xml'), Astro.site)}
    />

    <!--
      Open Graph：微信 / Telegram / Discord 等转链卡片。
      locale 跟页面语言走，并声明另一语言为 alternate；
      图片绝对地址由 site 域名推导，尺寸与 scripts/og.mjs 产物一致（1200×630）。
    -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={t.brand.siteName} />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:locale:alternate" content={ogLocale[other]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}

    <!-- Twitter/X 卡片：大图模式，与 OG 同源 -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- 视图过渡：多页间 SPA 式切换，巨字与流体墨不断帧 -->
    <ClientRouter />
  </head>

  <body>
    <!-- 流体墨画布：persist 跨页持久，GL 上下文连续 -->
    <canvas id="ink-canvas" transition:persist="ink"></canvas>

    <!-- 键盘跳转：直达正文 -->
    <a class="skip-link" href="#main">{t.base.skipToContent}</a>

    <!-- 顶栏：品牌（器皿标记 + 双语字）/ 导航+检索功能群 / 年份水印 -->
    <header class="topbar">
      <a class="topbar__brand" href={localePath(lang, '/')}>
        <!-- 器皿标记：与 favicon.svg 完全同源的路径（2026-09-10 三轮进驻顶栏，
             替换 9px 朱砂方块占位符）。viewBox 已裁到内容包围盒正方（527 442 906 906），
             fill=currentColor 随 brand 文字同色，悬停 brand 区转朱砂（见 global.css）；
             pulse 呼吸不转移——品牌标记宜静，动效语言由导航承担 -->
        <svg class="topbar__mark" viewBox="527 442 906 906" aria-hidden="true" focusable="false">
          <path
            fill="currentColor"
            fill-rule="nonzero"
            transform="translate(0 1920) scale(0.1 -0.1)"
            d="M10900 14569 c-173 -26 -347 -139 -440 -284 -62 -100 -82 -158 -88 -262 -4 -80 -1 -103 21 -175 49 -154 155 -278 304 -356 84 -44 144 -58 368 -86 144 -19 241 -60 300 -129 49 -56 59 -78 90 -188 15 -52 45 -130 68 -174 126 -243 416 -373 716 -321 215 38 380 154 467 330 93 190 78 374 -48 562 -54 81 -131 143 -233 190 -90 41 -150 54 -305 64 -232 15 -312 40 -395 126 -53 54 -83 117 -119 244 -42 147 -112 255 -218 335 -144 109 -309 151 -488 124z M10530 12846 c-267 -56 -464 -176 -607 -370 -161 -218 -201 -456 -118 -702 71 -212 262 -408 493 -505 142 -59 161 -62 512 -68 281 -6 330 -9 365 -24 53 -24 92 -62 120 -117 84 -167 -11 -364 -193 -400 -243 -49 -360 -91 -492 -179 -92 -62 -256 -231 -314 -324 -103 -166 -174 -379 -195 -591 -6 -60 -11 -232 -11 -382 0 -162 -5 -295 -11 -326 -49 -233 -283 -397 -512 -359 -190 32 -330 170 -372 366 -13 60 -15 309 -15 1781 0 1316 -3 1713 -12 1722 -19 19 -1323 17 -1443 -3 -510 -82 -932 -448 -1088 -941 -65 -207 -62 -125 -62 -1474 0 -1202 1 -1228 22 -1370 55 -370 149 -675 304 -983 308 -613 816 -1105 1449 -1405 311 -148 629 -239 965 -278 178 -21 594 -15 755 11 748 117 1399 490 1871 1071 327 402 551 889 658 1429 51 261 61 480 61 1344 0 821 -2 797 71 946 21 44 60 107 85 140 293 387 310 782 48 1114 -81 102 -153 160 -279 221 -144 71 -189 80 -525 110 -128 11 -205 32 -295 78 -66 33 -111 71 -257 215 -118 116 -227 186 -358 229 -94 32 -97 32 -325 34 -163 2 -249 -1 -295 -10z m-2234 -2040 c89 -42 153 -112 192 -210 14 -37 16 -129 17 -856 1 -743 2 -824 19 -915 69 -382 265 -672 571 -848 181 -104 340 -141 575 -134 188 5 267 24 425 101 316 155 539 451 621 826 12 54 18 154 23 355 7 279 7 280 34 337 38 78 104 143 182 179 87 41 197 43 279 6 109 -50 185 -152 205 -277 14 -83 14 -303 1 -445 -57 -618 -356 -1136 -840 -1455 -514 -338 -1187 -380 -1744 -110 -191 93 -334 196 -491 354 -240 241 -386 490 -480 815 -68 239 -68 238 -72 1133 -3 521 0 827 6 863 23 125 115 242 224 284 76 29 186 28 253 -3z"
          />
        </svg>
        <span>UNVESSEL</span>
        <span class="topbar__zh">不器</span>
      </a>
      <!-- 右侧功能群：导航 / 明暗切换 / 语言切换 / 检索归组（margin-left:auto 整体推右）；
           检索以发丝分隔线挂在功能群头部，消除「孤悬最右端」的突兀感；
           EST.2026 移出功能群、贴最右端作句号水印 -->
      <div class="topbar__end">
        <nav class="topbar__nav" aria-label={t.base.navAria}>
          {NAV.map((item) => (
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              <i>{item.no}</i>
              <span>{item.label}</span>
            </a>
          ))}
        </nav>
        <span class="topbar__divider" aria-hidden="true"></span>

        <!--
          明暗切换按钮（交互在 main.js）：点击在 data-theme light/dark 间翻转
          并写入 localStorage。SSR 不知道客户端最终主题（localStorage 只在
          浏览器可读），故默认渲染「切到亮色」语境：太阳图标 + themeToLight
          文案；main.js 初始化与视图过渡后按实际主题校正 aria-label 与图标
          显隐（CSS 按 html[data-theme] 切换两个 svg 的 display）。
        -->
        <button
          class="topbar__theme"
          type="button"
          data-theme-toggle
          aria-label={t.base.themeToLight}
        >
          <!-- 太阳：暗色语境下显示（点击 → 亮色） -->
          <svg class="topbar__theme-sun" viewBox="0 0 20 20" width="16" height="16" fill="none" aria-hidden="true">
            <circle cx="10" cy="10" r="3.6" stroke="currentColor" stroke-width="1.5" />
            <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
              <path d="M10 1.6v2.1" /><path d="M10 16.3v2.1" />
              <path d="M1.6 10h2.1" /><path d="M16.3 10h2.1" />
              <path d="M4.1 4.1l1.5 1.5" /><path d="M14.4 14.4l1.5 1.5" />
              <path d="M15.9 4.1l-1.5 1.5" /><path d="M5.6 14.4l-1.5 1.5" />
            </g>
          </svg>
          <!-- 月亮：亮色语境下显示（点击 → 暗色） -->
          <svg class="topbar__theme-moon" viewBox="0 0 20 20" width="16" height="16" fill="none" aria-hidden="true">
            <path
              d="M16.6 12.4A7.2 7.2 0 0 1 7.6 3.4a7.2 7.2 0 1 0 9 9z"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linejoin="round"
            />
          </svg>
        </button>

        <!--
          语言切换：纯 <a> 链接（无 JS 也能用），指向当前页在另一语言下的
          对应地址（otherLocalePath：/posts/abc/ ↔ /en/posts/abc/）。
          按钮文字显示「目标语言」（中文站显 EN，英文站显 中）。
        -->
        <a
          class="topbar__lang"
          href={otherLocalePath(other, path)}
          aria-label={t.base.langAria}
        >{t.base.langBtn}</a>

        <!-- 检索按钮：SVG 描边放大镜（2026-09-10 二次调整：文本 ⌕ 字形发虚，
             透明触达区在毛玻璃底上被读成一块突兀深色方块；描边图标与顶栏
             发丝线同一语言，烟灰常驻、悬停转骨白） -->
        <button class="topbar__search" type="button" data-search-open aria-label={t.base.searchAria}>
          <svg viewBox="0 0 20 20" width="16" height="16" fill="none" aria-hidden="true">
            <circle cx="8.5" cy="8.5" r="5.75" stroke="currentColor" stroke-width="1.5" />
            <path d="M13 13 L17 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
        </button>
      </div>
      <p class="topbar__meta">EST.2026</p>
    </header>

    <!-- 页面内容：各页自行铺排 -->
    <main id="main">
      <slot />
    </main>

    <!-- 页脚（2026-09-11 落款式重构）：告别三栏竖排站点地图，改为两层构图——
         ① 信息层：联络与版权两行 mono 细字；
         ② 落款层：横排编号字行（衬线大字 + mono 小号，沿用顶栏 NAV 编号语言）
            + 「字+印」同框收尾——书法作品写完落款钤印，印随字沉入渊里 -->
    <footer class="footer">
      <!-- 信息层：左联络右版权，两端对齐 -->
      <div class="footer__meta">
        <div class="footer__contact">
          <p class="footer__label">{t.base.contact}</p>
          <p class="footer__links">
            <a href={`mailto:${PROFILE.email}`}>{PROFILE.email}</a>
            <!-- RSS 按语言指向对应 feed（/feed.xml 或 /en/feed.xml） -->
            <a href={localePath(lang, '/feed.xml')}>RSS</a>
            {PROFILE.links.github && <a href={PROFILE.links.github} target="_blank" rel="noopener noreferrer">GITHUB</a>}
          </p>
        </div>
        <p class="footer__fine" set:html={t.base.fine1 + '<br />' + t.base.fine2} />
      </div>
      <!-- 站点地图：横排编号字行——复用顶部 NAV 数组，加板块只改一处，页脚自动跟上；
           结构与顶栏 <i>编号</i><span>标签</span> 同构，编号语言全站一致 -->
      <p class="footer__label">{t.base.sitemap}</p>
      <nav class="footer__map" aria-label={t.base.sitemapAria}>
        {NAV.map((item) => (
          <a href={item.href}>
            <i>{item.no}</i>
            <span>{item.label}</span>
          </a>
        ))}
      </nav>
      <!-- 落款：沉底巨字 + 朱砂印同框（品牌视觉，不随语言翻译）。
           下半裁掉像字沉入渊里，印钤在字侧不被裁——完整收尾 -->
      <div class="footer__sign" aria-hidden="true">
        <p class="footer__big">不器</p>
        <span class="seal">不器</span>
      </div>
    </footer>

    <!-- 噪点覆层与自定义光标：固定层，persist 保持连续 -->
    <div class="grain" aria-hidden="true" transition:persist="grain"></div>
    <div class="cursor" aria-hidden="true" transition:persist="cursor">
      <span class="cursor__dot"></span>
      <span class="cursor__ring"></span>
    </div>

    <!-- 站内检索浮层：Ctrl/⌘+K 或顶栏「检索」唤起（交互在 main.js） -->
    <SearchModal lang={lang} />

    <!-- 无 JS 降级：所有显现元素直接可见（配合 CSS .no-js 规则） -->
    <noscript>
      <style>
        [data-rv],
        .hero__title .gi {
          opacity: 1 !important;
          transform: none !important;
        }
        /* 检索与主题切换依赖 JS（Pagefind 索引 / localStorage）：
           无 JS 时隐藏入口与骨架。语言切换是纯链接，保留可用 */
        .topbar__search,
        .topbar__theme,
        .search {
          display: none !important;
        }
      </style>
    </noscript>

    <!--
      脚本装配：astro:page-load 在首次加载与每次视图过渡后都会触发，
      ink（幂等启动，persist 画布续跑）与 main（幂等初始化）各就各位。
    -->
    <script>
      import { startInk } from '../scripts/ink.js';
      import { initPage } from '../scripts/main.js';

      document.addEventListener('astro:page-load', () => {
        startInk();
        initPage();
      });
    </script>
  </body>
</html>
